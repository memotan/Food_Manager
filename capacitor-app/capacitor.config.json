{
  "appId": "com.foodmanager.app",
  "appName": "Food Inv. Manager",
  "webDir": "www",
  "server": {
    "url": "https://memotan.github.io/Food_Manager/",
    "androidScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "backgroundColor": "#111111",
      "style": "DARK",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#111111",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
